# Gemini powers the real AI analysis. Never expose it in the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# TinyFish powers the live public-policy check.
TINYFISH_API_KEY=
TINYFISH_AGENT_URL=https://agent.tinyfish.ai/v1/automation/run
# The autonomous CDP demonstration runs in a separate persistent worker.
# Set these in Vercel after deploying /worker to Railway or Render.
AGENT_WORKER_URL=https://YOUR-WORKER-DOMAIN
AGENT_WORKER_SECRET=
# Exact ClaimBack deployment origin. Only /returnmaze-demo.html is allowed.
ALLOWED_DEMO_ORIGIN=https://YOUR-CLAIMBACK-DOMAIN

# Required for real sign-up/sign-in. Create a free Supabase project, then add these in Vercel.
SUPABASE_URL=
SUPABASE_ANON_KEY=
