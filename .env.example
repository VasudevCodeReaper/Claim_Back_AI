# Gemini powers the real AI analysis. Never expose it in the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# TinyFish powers the live public-policy check.
TINYFISH_API_KEY=
TINYFISH_AGENT_URL=https://agent.tinyfish.ai/v1/automation/run
# Optional: the supervised DemoMart QA browser stream. Leave at this default.
TINYFISH_SSE_URL=https://agent.tinyfish.ai/v1/automation/run-sse

# Required for real sign-up/sign-in. Create a free Supabase project, then add these in Vercel.
SUPABASE_URL=
SUPABASE_ANON_KEY=
