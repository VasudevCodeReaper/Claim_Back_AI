# Run this worker on a persistent service such as Railway or Render — not Vercel.
PORT=3001
TINYFISH_API_KEY=
TINYFISH_BROWSER_API_URL=https://api.browser.tinyfish.ai
AGENT_WORKER_SECRET=
# Gemini plans each allowed next chat message from the live ReturnMaze reply.
# Use the same key/model already configured in Vercel.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Exact public ClaimBack deployment origin. The worker permits only /returnmaze-demo.html there.
ALLOWED_DEMO_ORIGIN=https://YOUR-CLAIMBACK-DOMAIN
